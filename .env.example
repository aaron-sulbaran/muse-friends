# Setup: see the Env line under Stack in docs/TECH_SPEC.md.
MODEL_API_KEY=

# Production store (Supabase, server-side only; never expose the key to the browser).
# STORE is set to supabase in Vercel by scripts/push-env-to-vercel.sh; leave it unset locally to use the JSON file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORE=

# Platform lane. Production values live in Vercel; scripts/push-env-to-vercel.sh copies them from .env.
# One token per connected Muse account for the MCP front door (app/api/mcp). The push script
# generates both when they are missing; any random string of 24 or more characters works.
MCP_TOKEN_A=
MCP_TOKEN_B=

# Bring your own Muse (app/connect, /api/connector/start_plan, check_plan, respond, and the same three MCP tools).
# One shared key for judges. Everything stays closed (401) until it is set; 24 or more characters. The /connect page
# shows it, so treat it as public while it is set and unset or rotate it after the event.
# scripts/push-env-to-vercel.sh --with-judge-token generates it. Optional: BYOM_ROOMS_PER_HOUR (new rooms an hour, default 10).
MCP_TOKEN_JUDGE=
BYOM_ROOMS_PER_HOUR=

# Optional: read the demo reel live from its owner's own Instagram (Instagram API with Instagram Login).
# Without it the seeded, fictional reel is used. INSTAGRAM_REEL_ID picks another of the owner's reels.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_REEL_ID=

# Rooms a phone makes on its first reel or control (?room=<id>), counted an hour at a time across everyone. Default 60.
PHONE_ROOMS_PER_HOUR=
